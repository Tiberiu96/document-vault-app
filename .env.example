APP_NAME=Vaulty
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://vaulty.test
APP_LOCALE=ro
APP_FALLBACK_LOCALE=ro
APP_FAKER_LOCALE=ro_RO

# Configureaza local; nu trimite valorile in conversatie.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Activeaza Redis pentru cache/queue numai dupa configurare si verificare.
CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1

FILESYSTEM_DISK=local
LOG_CHANNEL=stack
LOG_LEVEL=warning
# Transport local fara livrare externa; evita logarea continutului documentelor.
MAIL_MAILER=array
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Vault

# Rezervate pentru etapele viitoare; nu sunt integrari implementate.
VAULT_AI_ENABLED=false
VAULT_AI_PROVIDER=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=
VAULT_PUSH_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=
VAULT_ANALYTICS_ENABLED=false
VAULT_ANALYTICS_PROVIDER=

AI_ENABLED=false
AI_PROVIDER=ollama
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_TIMEOUT=90
OLLAMA_NUM_CTX=8192
QPDF_BINARY=qpdf
PDFTOPPM_BINARY=pdftoppm
VAULT_FREE_STORAGE_BYTES=104857600

OCR_ENABLED=true
TESSERACT_BINARY=tesseract
OCRMYPDF_BINARY=ocrmypdf
PDFTOTEXT_BINARY=pdftotext
VAULT_FREE_OCR_PAGES=50
VAULT_FREE_AI_CALLS=10

# Provider remote optional; cheia se configureaza numai local.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

REMINDERS_ENABLED=true
# Activare numai dupa configurarea si verificarea providerului de email.
REMINDERS_EMAIL_ENABLED=false

# Backup numai in productie, dupa configurare si verificarea topologiei single-host.
BACKUP_ENABLED=false
BACKUP_SINGLE_HOST_CONFIRMED=false
BACKUP_R2_ACCOUNT_ID=
BACKUP_R2_JURISDICTION=default
BACKUP_R2_BUCKET=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
# Parola separata, minimum 24 caractere; pastreaza si o copie in managerul de parole.
BACKUP_RESTIC_PASSWORD=
BACKUP_ALERT_EMAIL=
BACKUP_RESTIC_BINARY=restic
BACKUP_MYSQLDUMP_BINARY=mysqldump
BACKUP_UPLOAD_KIB=2048
BACKUP_PROCESS_TIMEOUT=3600

# Cloudflare Turnstile: activeaza numai dupa configurarea widgetului Managed.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional: domenii separate prin virgula; implicit hostname-ul din APP_URL.
TURNSTILE_HOSTNAMES=
