[Unit]
Description=Vaulty controlled backup restore
After=mysql.service redis-server.service
Requires=mysql.service redis-server.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/vaulty-restore
TimeoutStartSec=6h
TimeoutStopSec=30
KillMode=control-group
UMask=0077
StandardOutput=journal
StandardError=null
